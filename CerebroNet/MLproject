name: CerebroNet
conda_env: conda.yaml

entry_points:
  main:
    command: "python src/api/main.py"
  train_mobilenet:
    command: "python src/training/train_mobilenet.py"
  train_efficientnet:
    command: "python src/training/train_efficientnet.py"
  train_baseline_cnn:
    command: "python src/training/train_baseline_cnn.py"
  train_svm:
    command: "python src/training/train_svm.py"
  train_mlp:
    command: "python src/training/train_mlp.py"
